  "steps": [
    {
      "title": "Meaning goes in",
      "lede": "The agent writes what each thing is and where it belongs. The schema gate checks the shape, that every reference resolves, and with a repository root that every cited line exists and holds code rather than prose.",
      "nodes": [
        "doc",
        "schema"
      ],
      "links": [
        "f1"
      ],
      "notes": [
        {
          "k": "candidate.json",
          "v": "Tiers, columns, order. Never an x or a y."
        },
        {
          "k": "Schema?",
          "v": "A citation that lands on a docstring fails here, not in review."
        }
      ]
    },
    {
      "title": "Geometry is computed, then checked",
      "lede": "The layout engine turns meaning into coordinates and widens the canvas until nothing is cramped. The geometry gate then measures what will actually be drawn: overlaps, clipped labels, connectors through boxes they do not touch.",
      "nodes": [
        "schema",
        "layout",
        "geometry"
      ],
      "links": [
        "f2",
        "f3"
      ],
      "notes": [
        {
          "k": "Compute layout",
          "v": "Retries with a wider canvas before giving up, so most fixes never reach the author."
        },
        {
          "k": "Geometry?",
          "v": "Runs on the computed scene, so a failure names a node, not a pixel."
        }
      ]
    },
    {
      "title": "Real browsers have the last word",
      "lede": "One self-contained HTML file is written with the cited code inside it, then loaded in Chromium and WebKit. Every text run is measured in its box and every step must light something.",
      "nodes": [
        "geometry",
        "render",
        "browser",
        "done"
      ],
      "links": [
        "f4",
        "f5",
        "f6"
      ],
      "notes": [
        {
          "k": "Write HTML",
          "v": "No server, no network: the reader gets the code with the diagram."
        },
        {
          "k": "Browsers?",
          "v": "WebKit catches what Chrome forgives, such as CSS filters on SVG."
        }
      ]
    },
    {
      "title": "Any gate can stop it",
      "lede": "The first failing gate ends the run with a non-zero exit and an actionable message, in the same vocabulary the author wrote in. A skipped gate is reported as skipped, never as passed.",
      "nodes": [
        "schema",
        "geometry",
        "browser",
        "fail"
      ],
